# Multi-stage non-root production Dockerfile for Next.js Web Frontend
# Stage 1: Install dependencies
FROM node:20-alpine@sha256:cb31057864fbb1b9c97b5d12fcfe9b674b88d3f77341857900b991873919e9fa AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY apps/web/package*.json ./
RUN npm ci --prefer-offline --no-audit

# Stage 2: Build Next.js application
FROM node:20-alpine@sha256:cb31057864fbb1b9c97b5d12fcfe9b674b88d3f77341857900b991873919e9fa AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# Stage 3: Minimal runner image
FROM node:20-alpine@sha256:cb31057864fbb1b9c97b5d12fcfe9b674b88d3f77341857900b991873919e9fa AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

USER nextjs

EXPOSE 3000

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3000 || exit 1

CMD ["npm", "start", "--", "-p", "3000"]
