# Hospitality Agent Cloud - Complete Environment Configuration Guide
PROJECT_NAME="Hospitality Agent Cloud"
VERSION="1.0.0"
ENVIRONMENT="development"  # set to "production" for production deployment
DEBUG=False
API_V1_STR="/api/v1"

# Security & Authentication (MANDATORY IN PRODUCTION)
SECRET_KEY="development_secret_key_change_in_production"
JWT_SECRET_KEY="dev_jwt_secret_key_change_in_production"
JWT_REFRESH_SECRET_KEY="dev_refresh_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database & Connection Pooling
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/hospitality_agent_cloud"
READ_DATABASE_URL=""
PGVECTOR_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/hospitality_agent_cloud"
REDIS_URL="redis://localhost:6379/0"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Stripe SaaS Billing & Subscriptions
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_starter_..."
STRIPE_PRICE_PROFESSIONAL="price_pro_..."
STRIPE_PRICE_BUSINESS="price_business_..."
STRIPE_PRICE_ENTERPRISE="price_enterprise_..."

# Google SSO (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Models & Multi-Model Providers (LiteLLM Compatible)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
SARVAM_API_KEY=""
DEFAULT_LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=15.0

# Voice STT / TTS Providers
STT_PROVIDER="whisper"
TTS_PROVIDER="elevenlabs"
ELEVENLABS_API_KEY=""

# Document Storage (Local or AWS S3)
STORAGE_PROVIDER="local"
AWS_S3_BUCKET="hospitality-agent-rag-documents"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Observability & Alerts
ALERT_WEBHOOK_URL=""  # Slack / PagerDuty webhook for degraded /ready probes
SENTRY_DSN=""
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""

# Enterprise Security & KMS Envelope Encryption (Phase F2)
KMS_PROVIDER="aws_kms"  # "aws_kms", "gcp_kms", or "local_aes"
KMS_PRIMARY_KEY_ID=""   # AWS KMS Key ARN or GCP Key Resource ID
KMS_REGION="us-east-1"
DATA_RESIDENCY_REGION="US"  # "US", "EU", or "IN" (default legal pinning region)

# Enterprise Email Service & Notifications (Phase F1)
EMAIL_SERVICE_PROVIDER="smtp"  # "smtp", "sendgrid", or "ses"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="support@yourdomain.com"
SENDGRID_API_KEY=""

# WhatsApp Business Cloud API / Meta BSP (Phase F5)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="hac_whatsapp_verify_token"

# Customer SIEM Export (Phase F2)
SIEM_WEBHOOK_URL=""
SIEM_AUTH_TOKEN=""

# Enterprise Rate Limiting & Quotas (Phase F3)
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_ENTERPRISE_PER_MINUTE=1000
